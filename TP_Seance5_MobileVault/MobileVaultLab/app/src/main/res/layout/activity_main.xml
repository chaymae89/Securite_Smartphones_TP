<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F1F5F9">
 <LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MobileVault Lab" android:textSize="28sp" android:textStyle="bold" android:textColor="#173D58" android:paddingBottom="10dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Laboratoire pédagogique hors ligne : aucune donnée réelle." android:paddingBottom="18dp"/>
  <EditText android:id="@+id/passwordInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Mot de passe de démonstration" android:inputType="textPassword"/>
  <Button android:id="@+id/loginButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Se connecter"/>
  <Button android:id="@+id/logoutButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Se déconnecter"/>
  <EditText android:id="@+id/noteInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Note privée fictive" android:minLines="2" android:gravity="top"/>
  <Button android:id="@+id/saveButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Enregistrer note"/>
  <Button android:id="@+id/readButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lire note"/>
  <Button android:id="@+id/encodeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Protéger note (fonction à auditer)"/>
  <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Prêt pour l'audit" android:textColor="#173D58" android:textSize="16sp" android:padding="16dp"/>
 </LinearLayout>
</ScrollView>
